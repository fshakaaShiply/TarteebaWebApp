# API base without version (paths in the generated client start with /v1/...). Public pages only.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Admin panel API proxy (server-side only, no NEXT_PUBLIC_ prefix). The browser calls /backend/api/... and
# /backend/sanctum/csrf-cookie on this web origin; the Route Handler src/app/backend/[...path]/route.ts forwards them
# to this API origin (no path). Read at request time; a production server refuses to start without it (`pnpm dev`
# falls back to http://localhost:8000). Staging: https://tarteeba-api.shiplytechnologies.com
API_INTERNAL_URL=http://localhost:8000
